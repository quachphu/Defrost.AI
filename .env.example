# Defrosted.ai environment configuration.
# Copy to .env and fill in real values. Never commit .env.

# App
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (PostgreSQL 16 + PostGIS + pgvector)
DATABASE_URL=postgresql+asyncpg://defrosted:defrosted@localhost:5432/defrosted
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://localhost:6379/0

# AWS
AWS_REGION=us-east-1
S3_BUCKET_NAME=defrosted-documents
S3_DOCUMENTS_PREFIX=documents/

# AI
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=defrosted-production

# Communication
SENDGRID_API_KEY=SG.xxxxxxxx
OUTREACH_FROM_EMAIL=agent@defrosted.ai
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_PHONE_NUMBER=+14155552671
BLAND_AI_API_KEY=xxxxxxxx

# Browser automation
BROWSERBASE_API_KEY=bb_xxxxxxxx
BROWSERBASE_PROJECT_ID=xxxxxxxx

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=defrosted
TEMPORAL_TASK_QUEUE=rental-search-queue
